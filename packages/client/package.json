{
  "name": "@toon-protocol/client",
  "version": "2.1.2",
  "description": "TOON client: pay for HTTP requests per request over ILP, with EVM and Solana payment channels",
  "license": "MIT",
  "author": "Jonathan Green",
  "repository": {
    "type": "git",
    "url": "https://github.com/toon-protocol/toon-client.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "toon",
    "ilp",
    "interledger",
    "payment-channels",
    "micropayments",
    "btp",
    "x402",
    "evm",
    "solana"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "cli": "tsx src/cli/main.ts",
    "vectors:refresh": "node scripts/refresh-wire-vectors.mjs",
    "vectors:refresh:local": "node scripts/refresh-wire-vectors.mjs --from-local ../../../connector",
    "vectors:check": "node scripts/refresh-wire-vectors.mjs --check"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^1.4.0",
    "@scure/base": "^1.2.0",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "viem": "^2.0.0"
  },
  "optionalDependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "ws": "^8.19.0"
  },
  "bin": {
    "toon": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  }
}
