{
  "name": "toon-client",
  "version": "0.3.0",
  "private": true,
  "description": "TOON client — pay-per-request HTTP over Interledger, with payment channels settled on EVM and Solana.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "sandcastle:plan": "npx tsx .sandcastle/plan-dry-run.ts",
    "sandcastle:implement": "npx tsx .sandcastle/agent-implement-issue.ts",
    "sandcastle:fix": "npx tsx .sandcastle/agent-fix-pr.ts",
    "sandcastle:review": "npx tsx .sandcastle/agent-review-pr.ts"
  },
  "keywords": [
    "toon",
    "interledger",
    "ilp",
    "payment-channels",
    "micropayments",
    "btp",
    "evm",
    "solana"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@9.12.3",
  "pnpm": {
    "overrides": {
      "protobufjs": ">=7.2.5",
      "ws@>=7.0.0 <7.5.10": ">=7.5.10"
    },
    "auditConfig": {
      "ignoreCves": [
        "GHSA-vjh7-7g9h-fjfh",
        "GHSA-848j-6mx2-7j84",
        "GHSA-w7fw-mjwx-w883",
        "GHSA-49q7-c7j4-3p7m",
        "GHSA-c2qf-rxjj-qqgw"
      ]
    }
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.0.0",
    "zod": "^3.25.0",
    "@changesets/cli": "^2.27.9"
  }
}
